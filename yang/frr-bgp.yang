  augment "/frr-interface:lib/frr-interface:interface" {
    description
      "Augments interface model with BGP MPLS forwarding knobs.";

    leaf mpls-bgp-forwarding {
      type boolean;
      default "false";
      description
        "Enable MPLS forwarding for eBGP directly connected peers.";
    }

    leaf mpls-l3vpn-multi-domain-switching {
      type boolean;
      default "false";
      description
        "Bind a local MPLS label to incoming L3VPN updates on this
         interface.";
    }
  }
}
