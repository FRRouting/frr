#
# pmd
#

noinst_LIBRARIES += pmd/libpm.a
sbin_PROGRAMS += pmd/pmd
vtysh_daemons += pmd
man8 += $(MANBUILD)/frr-pmd.8

if PM_TRACKING
module_LTLIBRARIES += pmd/pm_tracking.la
endif

pmd_libpm_a_SOURCES = \
	pmd/pm_zebra.c \
	pmd/pm_vty.c \
	pmd/pm.c \
	pmd/pm_echo.c \
	pmd/pm_rtt.c \
	# end

clippy_scan += \
	pmd/pm_vty.c \
	# end

if PM_TRACKING
clippy_scan += \
	pmd/pm_tracking.c \
	# end
endif

noinst_HEADERS += \
	pmd/pm_vty.h \
	pmd/pm_zebra.h \
	pmd/pm.h \
	pmd/pm_memory.h \
	pmd/pm_echo.h \
	pmd/pm_rtt.h \
	# end

pmd_pmd_SOURCES = pmd/pm_main.c
pmd_pmd_LDADD = pmd/libpm.a lib/libfrr.la $(LIBCAP)

if PM_TRACKING
pmd_pm_tracking_la_SOURCES = pmd/pm_tracking.c
pmd_pm_tracking_la_LDFLAGS = $(MODULE_LDFLAGS)
endif
